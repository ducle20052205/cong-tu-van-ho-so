# Sao chép file này thành .env rồi điền giá trị thật.

# Gemini (Tuần 2: chatbot QnA thật ở trang chủ)
GEMINI_API_KEY=

# Supabase (Tuần 3: lưu hội thoại chatbot; database + auth ở các tuần sau)
# Chỉ dùng phía server (route handlers) — KHÔNG thêm tiền tố NEXT_PUBLIC_,
# vì SUPABASE_SECRET_KEY bỏ qua Row Level Security và không được lộ ra trình duyệt.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
